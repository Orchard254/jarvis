# ─────────────────────────────────────────────
# JARVIS CONFIGURATION
# Copy this file to .env and fill in your values
# Never commit .env to version control
# ─────────────────────────────────────────────

# ══════════════════════════════════
# LLM CONFIGURATION
# ══════════════════════════════════

# Ollama cloud API key (required for cloud mode)
# Get from: https://ollama.com/settings/api-keys
OLLAMA_API_KEY=f04e0eb1ab8945a690555a91ae31fd18.XuLgwVaCbFtqRAC9xhKbXsrm
# Ollama cloud endpoint
OLLAMA_CLOUD_URL=https://api.ollama.com/api/chat

# Ollama local endpoint (for offline fallback)
OLLAMA_LOCAL_URL=http://localhost:11434/api/chat
# Local model name
OLLAMA_LOCAL_MODEL=llama3

# Model to use
# Cloud options: gpt-oss:120b-cloud, nemotron-3-nano:30b-cloud
# Local options: llama3, mistral, phi3
OLLAMA_MODEL=gpt-oss:120b-cloud
# Vision model for screen analysis
# Requires multimodal model
# Cloud options: gemma3:27b-cloud
OLLAMA_VISION_MODEL=gemma3:4b-cloud

# Code generation model
OLLAMA_CODER_MODEL=codellama:latest

# LLM mode: cloud / local / auto
# auto = cloud when available, local as fallback
OLLAMA_MODE=auto

# Model temperature (0.0 = deterministic, 1.0 = creative)
OLLAMA_TEMPERATURE=0.7

# Max tokens for chat responses
OLLAMA_MAX_TOKENS = 4096

# Max tokens for agent tool planning
AGENT_MAX_TOKENS = 4096

# Timeout for LLM requests in seconds
OLLAMA_TIMEOUT=180

# Maximum retry attempts for LLM calls
OLLAMA_MAX_RETRIES=3

# Tool schemas per chat request: 0 = send all (recommended for cloud). Use 8–12 for small local models.
LLM_TOOL_SCHEMA_LIMIT=0

# How many prior chat messages the agent merges into the tool loop (user/assistant/tool roles).
TOOL_LOOP_HISTORY_MESSAGES=24

# Vision mode: true = convert screenshots to text summaries, false = pass images to main VL model
VISION_TO_TEXT_MODE=false
# Max screenshots to include in context per turn (0 = disabled, only relevant when VISION_TO_TEXT_MODE=false)
MAX_SCREENSHOTS_IN_CONTEXT=2


# ══════════════════════════════════
# AUDIO CONFIGURATION
# ══════════════════════════════════

# TTS engine: edge (default) | piper | kokoro
# edge  = Microsoft Edge TTS — no binary install, needs internet
# piper = local offline, needs piper.exe + model files
TTS_ENGINE=edge

# ── Edge TTS (primary) ────────────────────────────────────────────────────────
# Full list: python -m edge_tts --list-voices
EDGE_TTS_VOICE=en-GB-RyanNeural

# Rate offset: +10% faster, -10% slower (range: -50% to +100%)
EDGE_TTS_RATE=+10%

# Volume offset: +0% nominal (range: -100% to +100%)
EDGE_TTS_VOLUME=+0%

# Pitch offset: +0Hz nominal (range: -200Hz to +200Hz)
EDGE_TTS_PITCH=+0Hz

# Max seconds to wait for Edge TTS synthesis before falling back to Piper
EDGE_TTS_TIMEOUT=15

# ── Piper TTS (local fallback) ────────────────────────────────────────────────
# Piper TTS executable path
PIPER_EXE=piper_bin/piper/piper

# Piper voice model path
PIPER_MODEL=voices/en_US-lessac-medium.onnx

# ── Kokoro TTS (legacy) ───────────────────────────────────────────────────────
KOKORO_VOICE=bm_george
KOKORO_LANG_CODE=a
KOKORO_SPEED=1.15

# Microphone device index (-1 = auto detect)
MIC_DEVICE=-1

# Speaker device index (-1 = auto detect)
AUDIO_DEVICE=-1

# Sample rate for microphone recording
SAMPLE_RATE=16000

# Silence threshold for speech detection
SILENCE_THRESHOLD=400

# Seconds of silence before stopping recording
SILENCE_DURATION=1.5

# Maximum recording length in seconds
MAX_RECORD_SECS=30

# STT engine: google / whisper / vosk
STT_ENGINE=google

# STT language
STT_LANGUAGE=en-US

# ══════════════════════════════════
# WAKE WORD CONFIGURATION
# ══════════════════════════════════

# Wake word model name
# Options: alexa, hey_jarvis, hey_mycroft
WAKE_WORD=alexa

# Detection threshold (0.0-1.0)
# Higher = less sensitive, fewer false triggers
# Lower = more sensitive, more false triggers
WAKE_WORD_THRESHOLD=0.45

# Cooldown seconds after activation
# Prevents immediate re-activation during TTS
WAKE_WORD_COOLDOWN=3.0

# Enable continuous mode (no wake word required)
# true = always listening
# false = requires wake word
CONTINUOUS_MODE=false

# Wake word enabled (true/false)
WAKE_WORD_ENABLED=true

# ══════════════════════════════════
# AGENT CONFIGURATION
# ══════════════════════════════════

# Maximum conversation history pairs
MAX_HISTORY=10

# Maximum agentic rounds per request
MAX_AGENT_ROUNDS=12

# Maximum tool iterations before giving up
MAX_TOOL_ITERATIONS = 14

# Agent mode: chat / agent
AGENT_MODE=agent

# ══════════════════════════════════
# MEMORY CONFIGURATION
# ══════════════════════════════════

# Working memory max messages
WORKING_MEMORY_MAX_MESSAGES=20

# Working memory max tokens
WORKING_MEMORY_MAX_TOKENS = 32000

# Memory retrieval limit
MEMORY_RETRIEVAL_LIMIT=5

# ══════════════════════════════════
# AMBIENT MONITORING
# ══════════════════════════════════

# Battery warning threshold percentage
BATTERY_WARN_THRESHOLD=20

# Battery critical threshold percentage
BATTERY_CRITICAL_THRESHOLD=10

# CPU spike threshold percentage
CPU_SPIKE_THRESHOLD=90

# Seconds of high CPU before alerting
CPU_SPIKE_DURATION=30

# Memory usage warning threshold percentage
MEMORY_WARN_THRESHOLD=85

# Disk usage warning threshold percentage
DISK_WARN_THRESHOLD=92

# Minutes of silence before idle suggestion
IDLE_MINUTES=20

# Seconds between ambient checks
MONITOR_INTERVAL=15

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=60

# Ambient monitoring enabled
AMBIENT_MONITORING=true

# ══════════════════════════════════
# PATHS
# ══════════════════════════════════

# Override user home directory (leave blank for auto)
USER_HOME=

# Log directory (leave blank for default ./logs)
LOG_DIR=

# Notes directory (leave blank for default ./notes)
NOTES_DIR=

# Reminders directory (leave blank for default ./reminders)
REMINDERS_DIR=

# Data directory
DATA_DIR=jarvis_data

# Config directory
CONFIG_DIR=config

# ══════════════════════════════════
# SAFETY
# ══════════════════════════════════

# Require confirmation for high risk actions
# true = ask before destructive operations
CONFIRM_DANGEROUS=true

# Enable audit logging of all tool executions
ENABLE_AUDIT_LOG=true

# Safety enabled
SAFETY_ENABLED=true

# ══════════════════════════════════
# LOGGING
# ══════════════════════════════════

# Log level: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# ══════════════════════════════════
# OPTIONAL INTEGRATIONS
# ══════════════════════════════════

# OpenWeatherMap API key (for weather tool)
# Get from: https://openweathermap.org/api
WEATHER_API_KEY=

# News API key (for news briefing skill)
# Get from: https://newsapi.org
NEWS_API_KEY=

# HuggingFace token (for model downloads)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=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

# ══════════════════════════════════
# USER PROFILE
# ══════════════════════════════════

# User name for personalization
USER_NAME=User

# ══════════════════════════════════
# SKILLS SYSTEM
# ══════════════════════════════════

# Skill match threshold (0.0-1.0)
SKILL_MATCH_THRESHOLD=0.75

# ══════════════════════════════════
# ADVANCED FEATURES
# ══════════════════════════════════

# Enable skills system
ENABLE_SKILLS=true

# Enable planning system
ENABLE_PLANNING=true

# Enable reflection system
ENABLE_REFLECTION=true

# Voice enabled by default
VOICE_ENABLED=true

# TTS enabled
TTS_ENABLED=true

# Wake word enabled
WAKE_WORD_ENABLED=true

# Fallback to local Ollama if cloud fails
FALLBACK_TO_LOCAL=true

# Conversation history limit
CONVERSATION_HISTORY_LIMIT=20

# Mode: chat / agent
MODE=agent
LLM_MODEL=gpt-oss:120b-cloud

# ══════════════════════════════════
# OUTBOUND MESSAGING (send_message tool)
# ══════════════════════════════════

# Email via SMTP — Gmail example (use an App Password, not your main password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Telegram Bot API
# 1) Create a bot: message @BotFather → /newbot
# 2) Get your chat ID: send a message to the bot, then GET /bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ══════════════════════════════════
# CALENDAR (time_calendar tool)
# ══════════════════════════════════

# Backend: outlook (default, requires Outlook installed) | ics (plain file)
CALENDAR_BACKEND=outlook

# Path to .ics file (only used when CALENDAR_BACKEND=ics)
ICS_CALENDAR_PATH=
