```gitignore
# Python compiled files
*.pyc
__pycache__/

# Logs and temporary files
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo

# Dependencies and builds
node_modules/
.venv/
venv/
dist/
build/
target/
.gradle/
.mypy_cache/
.pytest_cache/

# Coverage reports
coverage/
htmlcov/
.coverage

# System files
.DS_Store
Thumbs.db
```