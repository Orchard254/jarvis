```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
venv/
.venv/
.env
.env.local
.env.*

# Logs and temporary files
*.log
*.tmp

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
target/

# Coverage reports
coverage/
htmlcov/
.coverage

# System files
.DS_Store
Thumbs.db
```