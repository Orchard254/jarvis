```gitignore
# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log
jarvis/logs/
logs/

# Environment files
.env
.env.local
*.env.*

# Dependencies and virtual environments
venv/
.venv/
.env/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS generated files
.DS_Store
Thumbs.db
```