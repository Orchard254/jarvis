```gitignore
# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
venv/
.venv/

# Dependencies
node_modules/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
.coverage
coverage/
htmlcov/

# Pytest cache
.pytest_cache/

# MyPy cache
.mypy_cache/

# Distribution / packaging
dist/
build/
*.egg-info/

# Environment variables
.env
.env.local
*.env.*

# IDE specific
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```