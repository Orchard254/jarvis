```gitignore
# Python compiled files
*.pyc
__pycache__/

# Logs and temporary files
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Dependencies and virtual environments
.venv/
venv/
.mypy_cache/
.pytest_cache/

# Build and distribution directories
dist/
build/
target/

# Coverage reports
coverage/
htmlcov/
.coverage

# System files
.DS_Store
Thumbs.db
```