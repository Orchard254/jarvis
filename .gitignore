```gitignore
# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# Dependencies
node_modules/

# Logs
*.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Package distributions
dist/
build/
*.egg-info/

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/

# Environment files
.env
.env.local
*.env.*

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*$pyc.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg
```