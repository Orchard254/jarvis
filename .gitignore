```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
venv/

# Database files
*.db

# Logs
*.log

# Temporary files
*.tmp
*.swp
*.swo

# IDE and editor files
.vscode/
.idea/

# Environment variables
.env
.env.local
*.env.*

# Coverage reports
coverage/
htmlcov/
.coverage

# OS generated files
.DS_Store
Thumbs.db
```